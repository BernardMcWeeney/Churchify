---
// src/components/about/Values.astro
import Eyebrow from '../Eyebrow.astro';

const values = [
  {
    icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z",
    title: "Parish-first",
    copy: "Every decision starts with one question: does this serve parishes better? We build for how parishes actually work."
  },
  {
    icon: "M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z",
    title: "Honest & transparent",
    copy: "Clear pricing, no hidden fees, straightforward communication. We earn trust through transparency and reliability."
  },
  {
    icon: "M13 7h8m0 0v8m0-8l-8 8-4-4-6 6",
    title: "Long-term partnership",
    copy: "We're not here for a one-off project. Churchify is a managed service designed for years of reliable parish support."
  }
];
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mb-14 max-w-3xl text-center">
      <div class="flex justify-center"><Eyebrow>What we stand for</Eyebrow></div>
      <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">Values that shape every parish site.</h2>
    </div>

    <div class="mx-auto grid max-w-5xl grid-cols-1 gap-6 md:grid-cols-3">
      {values.map((value) => (
        <div class="rounded-2xl border border-border bg-card p-8 shadow-soft">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/12 text-accent">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d={value.icon} /></svg>
          </div>
          <h3 class="mt-6 font-serif text-xl font-bold">{value.title}</h3>
          <p class="mt-3 leading-relaxed text-muted-foreground">{value.copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>
