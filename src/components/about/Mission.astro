---
// src/components/about/Mission.astro
import Eyebrow from '../Eyebrow.astro';

const capabilities = [
  "Clear Design",
  "Daily Content",
  "Easy Administration",
  "Reliable Hosting",
  "Secure Donations",
  "Livestream",
  "Zero Technical Stress"
];
---

<section class="bg-secondary/40 py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
      <Eyebrow>Our mission</Eyebrow>
      <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">Give every parish a clear, living website so they can focus on ministry, not technology.</h2>
    </div>

    <div class="mx-auto mt-12 grid max-w-5xl gap-6 lg:grid-cols-2">
      <div class="relative overflow-hidden rounded-3xl bg-primary p-8 text-primary-foreground shadow-card md:p-10">
        <svg xmlns="http://www.w3.org/2000/svg" class="relative h-8 w-8 text-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" /></svg>
        <p class="relative mt-5 font-serif text-xl font-bold leading-snug text-white">We believe every parish, regardless of size or budget, deserves a professional online presence. Churchify exists to make that simple, affordable and stress-free.</p>
        <p class="relative mt-5 text-sm font-semibold text-accent">— The Churchify Team</p>
      </div>

      <div class="rounded-3xl border border-border bg-card p-8 shadow-card md:p-10">
        <Eyebrow>What we do</Eyebrow>
        <p class="mt-6 font-serif text-2xl font-bold leading-snug">We build and manage high-quality parish websites so parishes can focus on ministry, not technology.</p>
        <div class="mt-7 flex flex-wrap gap-2.5">
          {capabilities.map((item) => (
            <span class="rounded-sm bg-secondary px-3.5 py-1.5 text-xs font-semibold text-foreground">{item}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
