---
// src/components/PageHeader.astro
import { getImageMeta } from '../data/imageMeta';
import Eyebrow from './Eyebrow.astro';

interface Props {
  title: string;
  tagline: string;
  eyebrow?: string;
  image?: string;
  imageAlt?: string;
}

const { title, tagline, eyebrow, image = "/parishes/st-marys-altar.jpg", imageAlt = "" } = Astro.props;
const meta = getImageMeta(image);
---

<section class="relative overflow-hidden bg-primary">
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt={imageAlt}
      class="h-full w-full object-cover opacity-25"
      width={meta?.width}
      height={meta?.height}
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-primary/85 via-primary/92 to-primary"></div>
    <div class="pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full bg-accent/20 blur-3xl"></div>
    <div class="pointer-events-none absolute -left-24 bottom-0 h-72 w-72 rounded-full bg-white/5 blur-3xl"></div>
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-3xl px-6 py-24 text-center md:py-32 lg:px-8">
    {eyebrow && (
      <div class="flex justify-center">
        <Eyebrow tone="dark">{eyebrow}</Eyebrow>
      </div>
    )}
    <h1 class="mt-6 font-serif text-4xl font-bold text-white md:text-5xl lg:text-6xl">{title}</h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-primary-foreground/75 md:text-xl">{tagline}</p>
  </div>
</section>
