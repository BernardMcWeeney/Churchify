---
// src/components/PageHeader.astro
import { getImageMeta } from '../data/imageMeta';

interface Props {
  title: string;
  tagline: string;
  image?: string;
  imageAlt?: string;
}

const { title, tagline, image = "/parishes/st-marys-altar.jpg", imageAlt = "" } = Astro.props;
const meta = getImageMeta(image);
---

<section class="relative overflow-hidden py-24 md:py-32">
  <div class="absolute inset-0 z-0">
    <img
      src={image}
      alt={imageAlt}
      class="w-full h-full object-cover"
      width={meta?.width}
      height={meta?.height}
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-primary/90"></div>
  </div>

  <div class="mx-auto max-w-7xl relative z-10 px-6 lg:px-8 text-center">
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-serif font-bold mb-6 text-white">{title}</h1>
    <p class="text-lg md:text-xl max-w-2xl mx-auto leading-relaxed text-white/80">{tagline}</p>
  </div>
</section>
