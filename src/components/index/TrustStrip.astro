---
// src/components/index/TrustStrip.astro
import { trustPartners } from '../../data/parishes';
---

<section class="border-y border-border bg-card/60 py-12">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">
      Trusted by Catholic parishes across Ireland
    </p>
    <div class="mt-8 grid grid-cols-2 gap-x-8 gap-y-5 sm:grid-cols-4 lg:grid-cols-8">
      {trustPartners.map((partner) => (
        <a
          href={partner.url}
          target={partner.external ? "_blank" : undefined}
          rel={partner.external ? "noopener noreferrer" : undefined}
          class="group flex items-center justify-center text-center"
        >
          <span class="font-serif text-sm font-bold leading-tight text-muted-foreground/70 transition-colors group-hover:text-foreground">{partner.name.replace(" Parish", "")}</span>
        </a>
      ))}
    </div>
  </div>
</section>
