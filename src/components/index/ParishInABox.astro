---
// src/components/index/ParishInABox.astro
import Eyebrow from '../Eyebrow.astro';

interface Props {
  showIntro?: boolean;
}

const { showIntro = true } = Astro.props;

const included = [
  "Custom design & build",
  "Daily liturgical content",
  "Mass times & bulletins",
  "Stripe donations setup",
  "Livestream integration",
  "Social media automation",
  "Email newsletter setup",
  "Hosting, updates & support"
];
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    {showIntro && (
      <div class="mb-14 flex flex-col items-center text-center">
        <Eyebrow>Pricing</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl font-bold md:text-5xl">Simple, transparent pricing.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted-foreground">One managed parish website package, with the important parish features included.</p>
      </div>
    )}

    <div class="mx-auto max-w-5xl overflow-hidden rounded-3xl border border-border bg-card shadow-lift">
      <div class="grid lg:grid-cols-[0.95fr_1.05fr]">
        <!-- price panel -->
        <div class="relative overflow-hidden bg-gradient-to-br from-primary-light to-primary p-8 text-primary-foreground md:p-10">
          <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 rounded-full bg-accent/20 blur-3xl"></div>
          <div class="relative">
            <span class="eyebrow on-dark">Complete parish website</span>
            <div class="mt-8 flex items-end gap-2">
              <p class="font-serif text-6xl font-bold text-white">€2,000</p>
              <p class="mb-2 text-sm text-primary-foreground/65">once-off setup</p>
            </div>
            <div class="mt-7 rounded-2xl border border-white/10 bg-white/5 p-5">
              <p class="font-serif text-2xl font-bold text-white">€500 <span class="font-sans text-sm font-medium text-primary-foreground/65">per year</span></p>
              <p class="mt-1 text-xs text-primary-foreground/55">First-year total: €2,500 — then €500/year for hosting, support &amp; management.</p>
            </div>
            <a href="/contact/" class="btn btn-accent mt-8 w-full">Start your parish website</a>
            <p class="mt-4 text-center text-xs text-primary-foreground/55">No hidden fees · cancel anytime</p>
          </div>
        </div>

        <!-- included -->
        <div class="p-8 md:p-10">
          <h3 class="font-serif text-2xl font-bold">Everything included from day one.</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">Design, setup, technical care and ongoing support are bundled together so there are no surprise website management costs.</p>

          <div class="mt-7 grid grid-cols-1 gap-x-6 gap-y-3.5 sm:grid-cols-2">
            {included.map((item) => (
              <div class="flex items-center gap-3">
                <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-accent/12 text-accent">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <span class="text-sm font-medium text-foreground">{item}</span>
              </div>
            ))}
          </div>

          <div class="mt-8 flex items-start gap-3 rounded-2xl border border-border bg-secondary/40 p-5">
            <svg xmlns="http://www.w3.org/2000/svg" class="mt-0.5 h-5 w-5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            <p class="text-sm leading-relaxed text-muted-foreground">Managed for you after launch — updates, support, backups, security and ongoing care.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
