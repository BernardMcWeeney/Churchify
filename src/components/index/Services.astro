---
// src/components/index/Services.astro
import Eyebrow from '../Eyebrow.astro';
import { platformFeatures } from '../../data/features';
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-14 max-w-3xl">
      <Eyebrow>What's included</Eyebrow>
      <h2 class="mt-6 font-serif text-3xl font-bold md:text-5xl">The parish essentials, already built in.</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        Churchify is not just a brochure site. It is a complete parish website system for the things parishioners actually look for every week.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {platformFeatures.map((feature) => (
        <a href={`/features/${feature.slug}/`} class="card-lift group rounded-2xl border border-border bg-card p-6 shadow-soft">
          <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6">
              <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
            </svg>
          </div>
          <p class="mt-5 text-[11px] font-semibold uppercase tracking-widest text-accent">{feature.eyebrow}</p>
          <h3 class="mt-1.5 font-serif text-xl font-bold">{feature.title}</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">{feature.description}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-foreground transition-colors group-hover:text-accent">
            See how it works
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
          </span>
        </a>
      ))}

      <!-- closing call-to-action tile -->
      <div class="flex flex-col justify-between rounded-2xl bg-gradient-to-br from-primary-light to-primary p-6 text-primary-foreground shadow-card">
        <div>
          <h3 class="font-serif text-xl font-bold text-white">Everything in one managed package.</h3>
          <p class="mt-2.5 text-sm leading-relaxed text-primary-foreground/70">Design, setup and ongoing technical care, bundled together — no surprise website costs.</p>
        </div>
        <a href="/features/" class="btn btn-accent btn-sm mt-6 self-start">Explore all features</a>
      </div>
    </div>
  </div>
</section>
