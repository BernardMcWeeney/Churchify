---
// src/components/index/Services.astro
import { platformFeatures } from '../../data/features';
---

<section class="py-20 md:py-28 bg-secondary/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="max-w-3xl mb-14">
      <p class="text-xs uppercase tracking-widest text-accent mb-3 font-semibold">What's Included</p>
      <h2 class="text-3xl md:text-5xl font-serif font-bold mb-5">The parish essentials, already built in.</h2>
      <p class="text-muted-foreground text-lg leading-relaxed">
        Churchify is not just a brochure site. It is a complete parish website system for the things parishioners actually look for every week.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
      {platformFeatures.map((feature) => (
        <a href={`/features/${feature.slug}/`} class="group bg-card border border-border rounded-lg p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5">
          <div class="mb-5 flex h-11 w-11 items-center justify-center rounded-lg bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7">
              <path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} />
            </svg>
          </div>
          <p class="text-[11px] uppercase tracking-widest text-accent font-semibold">{feature.eyebrow}</p>
          <h3 class="mt-2 text-lg font-serif font-bold">{feature.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{feature.description}</p>
          <span class="mt-5 inline-flex items-center text-xs font-semibold text-foreground group-hover:text-accent">
            See how it works
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-1.5 h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-start justify-between gap-5 rounded-lg border border-border bg-card p-6 md:flex-row md:items-center">
      <div>
        <h3 class="font-serif text-2xl font-bold">Designed for parish life, not generic website admin.</h3>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">
          We keep the editor simple for your team, and we stay on hand for the technical work your parish should not have to worry about.
        </p>
      </div>
      <a href="/features/" class="inline-flex shrink-0 items-center justify-center rounded-lg bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-colors hover:bg-primary/90">
        Explore All Features
      </a>
    </div>
  </div>
</section>
