---
// src/components/index/HowItWorks.astro
import Eyebrow from '../Eyebrow.astro';

const steps = [
  ["01", "We talk", "Tell us about your parish, your needs and your vision. We guide you through everything from the first conversation."],
  ["02", "We build", "We design, build and set up your complete parish website with all your content ready to go."],
  ["03", "You're live", "Your parish goes online. We train your team and provide ongoing support and management long term."]
];
---

<section class="bg-secondary/40 py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-16 max-w-3xl">
      <Eyebrow>Getting started</Eyebrow>
      <h2 class="mt-6 font-serif text-3xl font-bold md:text-5xl">A straightforward route to launch.</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">From first conversation to a live, fully managed parish website, we handle the details and keep the process clear.</p>
    </div>

    <div class="relative grid grid-cols-1 gap-6 md:grid-cols-3">
      <!-- connecting line -->
      <div class="pointer-events-none absolute left-0 right-0 top-12 hidden h-px bg-gradient-to-r from-border via-accent/40 to-border md:block"></div>

      {steps.map(([num, title, copy]) => (
        <div class="relative rounded-2xl border border-border bg-card p-8 shadow-soft">
          <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary font-serif text-xl font-bold text-white shadow-soft">{num}</span>
          <h3 class="mt-6 font-serif text-2xl font-bold">{title}</h3>
          <p class="mt-3 leading-relaxed text-muted-foreground">{copy}</p>
        </div>
      ))}
    </div>
  </div>
</section>
