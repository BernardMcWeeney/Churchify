---
// src/components/index/Portfolio.astro
import { getImageMeta } from '../../data/imageMeta';
import { showcaseParishes } from '../../data/parishes';
---

<section class="py-20 md:py-28 bg-secondary/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-14 flex flex-col justify-between gap-6 lg:flex-row lg:items-end">
      <div class="max-w-3xl">
        <p class="text-xs uppercase tracking-widest text-accent mb-3 font-semibold">Showcase</p>
        <h2 class="text-3xl md:text-5xl font-serif font-bold mb-5">Real parish websites, real parish content.</h2>
        <p class="text-muted-foreground text-lg leading-relaxed">
          These are live parish websites using the kind of structure Churchify brings together: clear navigation, local imagery, daily content, livestream, donations, notices and Mass times.
        </p>
      </div>
      <a href="/parishes/" class="inline-flex items-center justify-center rounded-lg border border-border bg-card px-6 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-background">
        View Full Showcase
      </a>
    </div>

    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {showcaseParishes.map((parish) => (
        <article class="group overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5">
          <a href={`/parishes/${parish.slug}/`} class="block">
            <div class="relative overflow-hidden bg-muted">
              <img
                src={parish.image}
                alt={parish.alt}
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width={getImageMeta(parish.image)?.width}
                height={getImageMeta(parish.image)?.height}
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/80 via-primary/10 to-transparent opacity-90"></div>
              <span class="absolute bottom-3 left-3 rounded-md bg-accent px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-primary">{parish.location}</span>
            </div>
          </a>

          <div class="p-5">
            <h3 class="font-serif text-xl font-bold leading-tight">{parish.name}</h3>
            <p class="mt-1 text-sm font-medium text-accent">{parish.domain}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{parish.summary}</p>

            <div class="mt-5 flex flex-wrap gap-2">
              {parish.highlights.map((highlight) => (
                <span class="rounded-md bg-muted px-2.5 py-1 text-[11px] font-semibold text-foreground">{highlight}</span>
              ))}
            </div>

            <a href={`/parishes/${parish.slug}/`} class="mt-5 inline-flex items-center text-sm font-semibold text-foreground transition-colors hover:text-accent">
              Read Case Study
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
