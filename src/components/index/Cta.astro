---
// src/components/index/Cta.astro
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-primary px-6 py-16 shadow-lift md:px-16 md:py-20">
      <div class="absolute inset-0 z-0">
        <img src="/parishes/holy-family-church.webp" alt="" class="h-full w-full object-cover opacity-25" width="960" height="960" loading="lazy" decoding="async" />
        <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary/95 to-primary-light/90"></div>
        <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent/25 blur-3xl"></div>
      </div>

      <div class="relative z-10 mx-auto max-w-2xl text-center">
        <span class="eyebrow on-dark">Ready when you are</span>
        <h2 class="mt-6 font-serif text-3xl font-bold text-white md:text-5xl">Ready to bring your parish online?</h2>
        <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-primary-foreground/75">
          Join parishes across Ireland who trust Churchify for their modern online presence. €2,000 setup, then €500 per year — fully managed.
        </p>
        <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/contact/" class="btn btn-accent btn-lg">Get your parish online</a>
          <a href="/features/" class="btn btn-ghost-light btn-lg">See what's included</a>
        </div>
      </div>
    </div>
  </div>
</section>
