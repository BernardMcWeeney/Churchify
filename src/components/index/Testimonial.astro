---
// src/components/index/Testimonial.astro
import { getImageMeta } from '../../data/imageMeta';
import { parishTestimonials } from '../../data/parishes';

const testimonials = parishTestimonials.map((item) => ({
  ...item,
  rating: "rating" in item.testimonial ? item.testimonial.rating : undefined,
  source: "source" in item.testimonial ? item.testimonial.source : "Parish client",
  highlights: "highlights" in item.testimonial ? item.testimonial.highlights : []
}));
---

<section class="bg-primary py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-3xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">Testimonials</p>
        <h2 class="font-serif text-3xl font-bold text-primary-foreground md:text-4xl">What parishes say</h2>
        <p class="mt-4 text-lg leading-relaxed text-primary-foreground/72">
          Real parish teams using Churchify-style websites for weekly notices, Mass times, donations and parish communication.
        </p>
      </div>

      <div class="flex gap-2">
        <button type="button" data-testimonial-prev aria-label="Previous testimonial" class="flex h-11 w-11 items-center justify-center rounded-lg border border-white/15 text-primary-foreground transition-colors hover:bg-white/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button type="button" data-testimonial-next aria-label="Next testimonial" class="flex h-11 w-11 items-center justify-center rounded-lg border border-white/15 text-primary-foreground transition-colors hover:bg-white/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>

    <div data-testimonial-track class="flex gap-6 overflow-x-auto scroll-smooth pb-1">
      {testimonials.map((item) => (
        <article data-testimonial-card class="min-w-[88%] overflow-hidden rounded-lg border border-white/10 bg-white/[0.06] shadow-xl shadow-black/10 md:min-w-[70%] lg:min-w-[calc(50%-0.75rem)]">
          <div class="grid min-h-full grid-cols-1 sm:grid-cols-[0.36fr_0.64fr]">
            <div class="relative bg-primary/40">
              <img
                src={item.image}
                alt=""
                class="aspect-[4/3] w-full object-cover sm:h-full"
                width={getImageMeta(item.image)?.width}
                height={getImageMeta(item.image)?.height}
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/55 via-transparent to-transparent"></div>
            </div>

            <div class="flex flex-col p-6 md:p-8">
              <div class="flex flex-wrap items-center gap-3">
                {item.rating && (
                  <div class="flex gap-1 text-accent" aria-label={`${item.rating} star review`}>
                    {Array.from({ length: item.rating }).map(() => (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81H7.03a1 1 0 00.95-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>
                )}
                <span class="rounded-md border border-white/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-primary-foreground/72">
                  {item.source}
                </span>
              </div>

              <div class="mt-5 text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                </svg>
              </div>

              <blockquote class="mt-4 flex-1 text-base leading-relaxed text-primary-foreground/84">
                {item.testimonial.quote}
              </blockquote>

              {item.highlights.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-white/10 pt-5">
                  {item.highlights.map((highlight) => (
                    <li class="flex gap-2 text-sm leading-relaxed text-primary-foreground/70">
                      <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded bg-accent text-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                      </span>
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-6 border-t border-white/10 pt-5">
                <p class="font-serif font-bold text-primary-foreground">{item.testimonial.author}</p>
                <p class="text-sm text-primary-foreground/58">{item.testimonial.role}</p>
                <a href={item.url} class="mt-1 inline-flex text-xs font-semibold text-accent transition-colors hover:text-accent/80">{item.parish}</a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-testimonial-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-testimonial-next]');

  const scrollTestimonials = (direction: number) => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('[data-testimonial-card]');
    const gap = 24;
    const amount = card ? card.offsetWidth + gap : track.clientWidth;
    track.scrollBy({ left: amount * direction, behavior: 'smooth' });
  };

  prev?.addEventListener('click', () => scrollTestimonials(-1));
  next?.addEventListener('click', () => scrollTestimonials(1));
</script>

<style is:global>
  [data-testimonial-track] {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  [data-testimonial-track]::-webkit-scrollbar {
    display: none;
  }
</style>
