---
// src/components/index/Testimonial.astro
import Eyebrow from '../Eyebrow.astro';
import { getImageMeta } from '../../data/imageMeta';
import { parishTestimonials } from '../../data/parishes';

const testimonials = parishTestimonials.map((item) => ({
  ...item,
  meta: getImageMeta(item.image),
  rating: "rating" in item.testimonial ? item.testimonial.rating : undefined,
  source: "source" in item.testimonial ? item.testimonial.source : "Parish client"
}));
---

<section class="relative overflow-hidden bg-primary py-20 md:py-28">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div class="max-w-3xl">
        <Eyebrow tone="dark">Testimonials</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl font-bold text-white md:text-5xl">What parishes say.</h2>
        <p class="mt-4 text-lg leading-relaxed text-primary-foreground/70">
          Real parish teams using Churchify websites for weekly notices, Mass times, donations and parish communication.
        </p>
      </div>

      <div class="flex gap-2">
        <button type="button" data-testimonial-prev aria-label="Previous testimonial" class="flex h-12 w-12 items-center justify-center rounded-sm border border-white/15 text-white transition-colors hover:bg-white/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
        </button>
        <button type="button" data-testimonial-next aria-label="Next testimonial" class="flex h-12 w-12 items-center justify-center rounded-sm border border-white/15 text-white transition-colors hover:bg-white/10">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
    </div>

    <div data-testimonial-track class="flex gap-6 overflow-x-auto scroll-smooth pb-2">
      {testimonials.map((item) => (
        <article data-testimonial-card class="min-w-[88%] overflow-hidden rounded-3xl border border-white/10 bg-white/[0.07] backdrop-blur-sm md:min-w-[70%] lg:min-w-[calc(50%-0.75rem)]">
          <div class="grid min-h-full grid-cols-1 sm:grid-cols-[0.38fr_0.62fr]">
            <div class="relative min-h-[220px]">
              <img
                src={item.image}
                alt={item.alt}
                class="absolute inset-0 h-full w-full object-cover"
                width={item.meta?.width}
                height={item.meta?.height}
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-primary/65 via-primary/10 to-transparent sm:bg-gradient-to-r"></div>
              <div class="absolute inset-x-0 bottom-0 p-4 sm:hidden">
                <p class="font-serif text-lg font-bold text-white">{item.parish}</p>
                <p class="text-xs font-semibold uppercase tracking-wider text-accent-light">{item.location}</p>
              </div>
            </div>

            <div class="flex flex-col p-7 md:p-9">
              <div class="flex flex-wrap items-center gap-3">
                {item.rating && (
                  <div class="flex gap-0.5 text-accent" aria-label={`${item.rating} star review`}>
                    {Array.from({ length: item.rating }).map(() => (
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81H7.03a1 1 0 00.95-.69l1.07-3.292z" /></svg>
                    ))}
                  </div>
                )}
                <span class="rounded-sm border border-white/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-primary-foreground/70">{item.source}</span>
              </div>

              <blockquote class="mt-5 flex-1 font-serif text-lg leading-snug text-white md:text-xl">
                <span class="text-accent">“</span>{item.testimonial.quote}<span class="text-accent">”</span>
              </blockquote>

              <div class="mt-6 border-t border-white/10 pt-5">
                <p class="font-serif font-bold text-white">{item.testimonial.author}</p>
                <p class="text-sm text-primary-foreground/55">{item.testimonial.role}</p>
                <a href={item.url} class="mt-1.5 inline-flex items-center gap-1 text-xs font-semibold text-accent transition-colors hover:text-accent-light">
                  {item.parish}
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-testimonial-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-testimonial-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-testimonial-next]');

  const scrollTestimonials = (direction: number) => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('[data-testimonial-card]');
    const gap = 24;
    const amount = card ? card.offsetWidth + gap : track.clientWidth;
    track.scrollBy({ left: amount * direction, behavior: 'smooth' });
  };

  prev?.addEventListener('click', () => scrollTestimonials(-1));
  next?.addEventListener('click', () => scrollTestimonials(1));
</script>

<style is:global>
  [data-testimonial-track] {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  [data-testimonial-track]::-webkit-scrollbar {
    display: none;
  }
</style>
