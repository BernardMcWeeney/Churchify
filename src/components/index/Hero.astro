---
// src/components/index/Hero.astro
import { getImageMeta } from '../../data/imageMeta';
import { showcaseParishes } from '../../data/parishes';

const previewParishes = showcaseParishes.slice(0, 4);
const heroImage = "/parishes/duleek-aerial.webp";
const heroImageMeta = getImageMeta(heroImage);
---

<section class="relative overflow-hidden pt-16 pb-20 lg:pt-24 lg:pb-28">
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/60 to-transparent"></div>

  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-12 lg:gap-16 items-center">

      <!-- Copy -->
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 mb-8 border border-accent/30 bg-accent/10 rounded-full">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          <span class="text-xs font-semibold tracking-wide uppercase text-accent-foreground">Managed parish websites for Ireland</span>
        </div>

        <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.05] tracking-tight text-foreground">
          Parish websites that feel alive every day.
        </h1>

        <p class="mt-6 text-lg leading-relaxed text-muted-foreground max-w-xl">
          Churchify designs, builds and fully manages beautiful Catholic parish websites with Mass times, notices, bulletins, donations, livestream and daily liturgical content built in.
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-4">
          <a href="/contact/" class="inline-flex items-center justify-center bg-primary text-primary-foreground hover:bg-primary/90 font-semibold px-8 py-4 rounded-lg text-base transition-colors">
            Start Your Parish Site
            <svg xmlns="http://www.w3.org/2000/svg" class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a href="/parishes/" class="inline-flex items-center justify-center border border-border text-foreground hover:bg-secondary font-semibold px-8 py-4 rounded-lg text-base transition-colors">
            View Showcase
          </a>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-4 max-w-xl">
          <div class="border-l border-accent/40 pl-4">
            <p class="font-serif text-2xl font-bold text-foreground">8</p>
            <p class="text-xs leading-snug text-muted-foreground mt-1">Showcase parish websites</p>
          </div>
          <div class="border-l border-accent/40 pl-4">
            <p class="font-serif text-2xl font-bold text-foreground">100%</p>
            <p class="text-xs leading-snug text-muted-foreground mt-1">Managed support</p>
          </div>
          <div class="border-l border-accent/40 pl-4">
            <p class="font-serif text-2xl font-bold text-foreground">€500</p>
            <p class="text-xs leading-snug text-muted-foreground mt-1">Per year ongoing</p>
          </div>
        </div>
      </div>

      <!-- Product mockup -->
      <div class="relative lg:pl-4">
        <div class="relative overflow-hidden rounded-lg border border-border bg-card shadow-2xl shadow-primary/10">
          <div class="flex items-center justify-between border-b border-border bg-secondary/60 px-4 py-3">
            <div class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-[#D56B5D]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#5E8E6E]"></span>
            </div>
            <div class="hidden sm:block rounded-md bg-background px-4 py-1 text-[11px] font-medium text-muted-foreground">
              parish.ie
            </div>
          </div>

          <div class="relative">
            <img
              src={heroImage}
              alt="Aerial view of a Churchify parish website hero image"
              class="aspect-[16/10] w-full object-cover"
              width={heroImageMeta.width}
              height={heroImageMeta.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/90 via-primary/25 to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
              <p class="text-xs uppercase tracking-widest text-accent font-semibold">Parish homepage</p>
              <h2 class="mt-2 font-serif text-2xl sm:text-3xl font-bold text-white">Welcome to Our Parish</h2>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-md bg-white/90 px-3 py-1 text-xs font-semibold text-primary">Mass Times</span>
                <span class="rounded-md bg-white/90 px-3 py-1 text-xs font-semibold text-primary">Watch Live</span>
                <span class="rounded-md bg-accent px-3 py-1 text-xs font-semibold text-primary">Donate</span>
              </div>
            </div>
          </div>

          <div class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
            <div class="bg-card p-4">
              <p class="text-[11px] uppercase tracking-widest text-muted-foreground">Today</p>
              <p class="mt-1 font-serif text-base font-bold text-foreground">Daily Readings</p>
              <p class="mt-1 text-xs text-muted-foreground">Updated automatically</p>
            </div>
            <div class="bg-card p-4">
              <p class="text-[11px] uppercase tracking-widest text-muted-foreground">Notices</p>
              <p class="mt-1 font-serif text-base font-bold text-foreground">Bulletin Live</p>
              <p class="mt-1 text-xs text-muted-foreground">Latest PDF and posts</p>
            </div>
            <div class="bg-card p-4">
              <p class="text-[11px] uppercase tracking-widest text-muted-foreground">Streaming</p>
              <p class="mt-1 font-serif text-base font-bold text-foreground">Any Platform</p>
              <p class="mt-1 text-xs text-muted-foreground">YouTube, Facebook, more</p>
            </div>
            <div class="bg-card p-4">
              <p class="text-[11px] uppercase tracking-widest text-muted-foreground">Giving</p>
              <p class="mt-1 font-serif text-base font-bold text-foreground">Stripe Ready</p>
              <p class="mt-1 text-xs text-muted-foreground">No extra setup charge</p>
            </div>
          </div>
        </div>

        <div class="mt-5 grid grid-cols-4 gap-3">
          {previewParishes.map((parish) => (
            <a href={`/parishes/${parish.slug}/`} class="group relative overflow-hidden rounded-lg border border-border bg-card">
              <img
                src={parish.image}
                alt={parish.alt}
                class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
                width={getImageMeta(parish.image)?.width}
                height={getImageMeta(parish.image)?.height}
                loading="lazy"
                decoding="async"
              />
              <span class="absolute inset-x-0 bottom-0 bg-primary/80 px-2 py-1 text-center text-[10px] font-semibold leading-tight text-white">{parish.name.replace(" Parish", "")}</span>
            </a>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
