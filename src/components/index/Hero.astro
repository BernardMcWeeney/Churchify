---
// src/components/index/Hero.astro
import { getImageMeta } from '../../data/imageMeta';
import { showcaseParishes } from '../../data/parishes';

const previewParishes = showcaseParishes.slice(0, 4);
const heroImage = "/parishes/duleek-aerial.webp";
const heroImageMeta = getImageMeta(heroImage);
---

<section class="relative overflow-hidden">
  <!-- quiet parish backdrop -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent/40 to-transparent"></div>
  </div>

  <div class="mx-auto max-w-7xl px-6 pt-16 pb-20 lg:px-8 lg:pt-24 lg:pb-28">
    <div class="grid items-center gap-12 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">

      <!-- Copy -->
      <div class="max-w-2xl">
        <span class="eyebrow">Managed parish websites · Ireland</span>

        <h1 class="mt-7 font-serif text-[2.75rem] font-bold leading-[1.04] text-foreground sm:text-6xl lg:text-[4.25rem]">
          Parish websites your community can rely on.
        </h1>

        <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground">
          Churchify designs, builds and fully manages Catholic parish websites around the weekly rhythm people already know: Mass times, notices, bulletins, donations, livestream and daily liturgical content.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/contact/" class="btn btn-primary btn-lg">
            Start your parish site
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
          </a>
          <a href="/parishes/" class="btn btn-outline btn-lg">View showcase</a>
        </div>

        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <div class="flex items-center gap-2">
            <div class="flex gap-0.5 text-accent" aria-label="5 star rated">
              {Array.from({ length: 5 }).map(() => (
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81H7.03a1 1 0 00.95-.69l1.07-3.292z" /></svg>
              ))}
            </div>
            <span class="text-sm font-medium text-muted-foreground">Loved by parish teams</span>
          </div>
          <div class="h-8 w-px bg-border"></div>
          <div class="flex items-center gap-2.5 text-sm text-muted-foreground">
            <span class="font-serif text-2xl font-bold text-foreground">8</span>
            <span class="leading-tight">live parish<br />websites</span>
          </div>
          <div class="flex items-center gap-2.5 text-sm text-muted-foreground">
            <span class="font-serif text-2xl font-bold text-foreground">100%</span>
            <span class="leading-tight">managed<br />for you</span>
          </div>
        </div>
      </div>

      <!-- Premium product visual -->
      <div class="relative lg:pl-6">
        <div class="relative overflow-hidden rounded-2xl border border-border bg-card shadow-[0_2px_6px_rgba(27,42,74,0.05),0_40px_80px_-24px_rgba(27,42,74,0.35)]">
          <div class="flex items-center justify-between border-b border-border bg-secondary/50 px-4 py-3">
            <div class="flex items-center gap-1.5">
              <span class="h-2.5 w-2.5 rounded-sm bg-[#D56B5D]"></span>
              <span class="h-2.5 w-2.5 rounded-sm bg-accent"></span>
              <span class="h-2.5 w-2.5 rounded-sm bg-[#5E8E6E]"></span>
            </div>
            <div class="hidden rounded-sm bg-background px-4 py-1 text-[11px] font-medium text-muted-foreground sm:block">yourparish.ie</div>
            <div class="w-12"></div>
          </div>

          <div class="relative">
            <img
              src={heroImage}
              alt="A Churchify parish website homepage"
              class="aspect-[16/10] w-full object-cover"
              width={heroImageMeta.width}
              height={heroImageMeta.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-primary/95 via-primary/30 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-6">
              <p class="text-xs font-semibold uppercase tracking-widest text-accent-light">Parish homepage</p>
              <h2 class="mt-2 font-serif text-2xl font-bold text-white sm:text-3xl">Welcome to Our Parish</h2>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-sm bg-white/95 px-3.5 py-1.5 text-xs font-semibold text-primary">Mass Times</span>
                <span class="rounded-sm bg-white/95 px-3.5 py-1.5 text-xs font-semibold text-primary">Watch Live</span>
                <span class="rounded-sm bg-accent px-3.5 py-1.5 text-xs font-semibold text-primary">Donate</span>
              </div>
            </div>
          </div>

          <div class="grid gap-px bg-border sm:grid-cols-2 lg:grid-cols-4">
            {[
              ["Today", "Daily Readings", "Updated automatically"],
              ["Notices", "Bulletin Live", "Latest PDF & posts"],
              ["Streaming", "Any Platform", "YouTube, Facebook…"],
              ["Giving", "Stripe Ready", "No extra setup fee"]
            ].map(([label, title, note]) => (
              <div class="bg-card p-4">
                <p class="text-[11px] uppercase tracking-widest text-muted-foreground">{label}</p>
                <p class="mt-1 font-serif text-base font-bold text-foreground">{title}</p>
                <p class="mt-1 text-xs text-muted-foreground">{note}</p>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- real parish previews -->
    <div class="mt-16 lg:mt-20">
      <p class="text-center text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Real parish communities we support</p>
      <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {previewParishes.map((parish) => (
          <a href={`/parishes/${parish.slug}/`} class="group card-lift relative overflow-hidden rounded-xl border border-border bg-card shadow-soft">
            <img
              src={parish.image}
              alt={parish.alt}
              class="aspect-[16/11] w-full object-cover"
              width={getImageMeta(parish.image)?.width}
              height={getImageMeta(parish.image)?.height}
              loading="lazy"
              decoding="async"
            />
            <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-primary/90 to-transparent px-3 pb-2.5 pt-8 text-xs font-semibold text-white">{parish.name.replace(" Parish", "")}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
