---
// src/components/index/Features.astro
const reasons = [
  {
    title: "Parishioners get what they need fast",
    description: "Mass times, livestream, bulletin, donations and notices are treated as primary content, not buried menu items."
  },
  {
    title: "Your team can keep it current",
    description: "The editing workflow is built around real parish tasks, with training and support when you need a hand."
  },
  {
    title: "The technical work is handled",
    description: "Hosting, security, backups, updates, monitoring, DNS and performance care are all part of the managed service."
  },
  {
    title: "SEO foundations are in place",
    description: "Clean page structure, metadata, sitemap, schema and fast image-led pages help search engines understand the parish site."
  }
];
---

<section class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-16 items-center">

      <div>
        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-xl shadow-primary/5">
          <img
            src="/parishes/st-marys-altar.jpg"
            alt="St. Mary's Parish Drogheda altar used in a Churchify parish website"
            class="aspect-[4/3] w-full object-cover"
            width="1024"
            height="573"
            loading="lazy"
            decoding="async"
          />
          <div class="border-t border-border bg-card p-5">
            <div class="grid grid-cols-3 gap-4 text-center">
              <div>
                <p class="font-serif text-xl font-bold text-foreground">Daily</p>
                <p class="mt-1 text-[11px] uppercase tracking-wider text-muted-foreground">Readings</p>
              </div>
              <div class="border-x border-border">
                <p class="font-serif text-xl font-bold text-foreground">Live</p>
                <p class="mt-1 text-[11px] uppercase tracking-wider text-muted-foreground">Mass</p>
              </div>
              <div>
                <p class="font-serif text-xl font-bold text-foreground">Stripe</p>
                <p class="mt-1 text-[11px] uppercase tracking-wider text-muted-foreground">Giving</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-8 lg:pt-0">
        <p class="text-xs uppercase tracking-widest text-accent mb-3 font-semibold">Why Churchify</p>
        <h2 class="text-3xl md:text-5xl font-serif font-bold mb-6">A modern site your parish does not have to stress over.</h2>
        <p class="text-muted-foreground text-lg mb-8 leading-relaxed">
          We build around the weekly rhythm of parish life: Mass, prayer, notices, bulletins, giving and pastoral communication. Then we manage the technical side so the site stays reliable.
        </p>

        <div class="space-y-4">
          {reasons.map((reason) => (
            <div class="flex gap-4 rounded-lg border border-border bg-card p-5">
              <div class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <div>
                <h3 class="font-serif text-lg font-bold">{reason.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{reason.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
