---
// src/components/index/Features.astro
import Eyebrow from '../Eyebrow.astro';
import { getImageMeta } from '../../data/imageMeta';

const shot = "/parishes/screenshots/donore-rossnaree-parish.webp";
const shotMeta = getImageMeta(shot);

const reasons = [
  {
    title: "Parishioners get what they need fast",
    description: "Mass times, livestream, bulletin, donations and notices are treated as primary content, not buried menu items."
  },
  {
    title: "Your team can keep it current",
    description: "The editing workflow is built around real parish tasks, with training and support when you need a hand."
  },
  {
    title: "The technical work is handled",
    description: "Hosting, security, backups, updates, monitoring, DNS and performance care are all part of the managed service."
  },
  {
    title: "SEO foundations are in place",
    description: "Clean page structure, metadata, sitemap, schema and fast image-led pages help search engines understand the parish site."
  }
];
---

<section class="bg-secondary/40 py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="grid grid-cols-1 items-center gap-14 lg:grid-cols-2 lg:gap-20">

      <div class="relative order-2 lg:order-1">
        <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-card">
          <div class="flex items-center gap-2 border-b border-border bg-secondary/50 px-4 py-2.5">
            <span class="h-2 w-2 rounded-full bg-[#D56B5D]"></span>
            <span class="h-2 w-2 rounded-full bg-accent"></span>
            <span class="h-2 w-2 rounded-full bg-[#5E8E6E]"></span>
            <span class="ml-2 text-[11px] font-medium text-muted-foreground">donorerossnareeparish.com</span>
          </div>
          <img
            src={shot}
            alt="A live Churchify parish website homepage"
            class="aspect-[16/11] w-full object-cover object-top"
            width={shotMeta?.width}
            height={shotMeta?.height}
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="absolute -bottom-5 -right-3 hidden rounded-xl border border-border bg-card px-5 py-4 shadow-lift sm:block lg:-right-6">
          <div class="grid grid-cols-3 gap-5 text-center">
            <div>
              <p class="font-serif text-lg font-bold text-foreground">Daily</p>
              <p class="text-[10px] uppercase tracking-wider text-muted-foreground">Readings</p>
            </div>
            <div class="border-x border-border px-2">
              <p class="font-serif text-lg font-bold text-foreground">Live</p>
              <p class="text-[10px] uppercase tracking-wider text-muted-foreground">Mass</p>
            </div>
            <div>
              <p class="font-serif text-lg font-bold text-foreground">Stripe</p>
              <p class="text-[10px] uppercase tracking-wider text-muted-foreground">Giving</p>
            </div>
          </div>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <Eyebrow>Why Churchify</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl font-bold md:text-5xl">A modern site your parish does not have to stress over.</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
          We build around the weekly rhythm of parish life — Mass, prayer, notices, bulletins, giving and pastoral communication — then manage the technical side so the site stays reliable.
        </p>

        <div class="mt-8 space-y-3">
          {reasons.map((reason) => (
            <div class="flex gap-4 rounded-2xl border border-border bg-card p-5 shadow-soft">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-accent/12 text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              </div>
              <div>
                <h3 class="font-serif text-lg font-bold">{reason.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{reason.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
