---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { getImageMeta } from '../../data/imageMeta';
import { platformFeatures } from '../../data/features';
import { showcaseParishes } from '../../data/parishes';

type Feature = (typeof platformFeatures)[number];

export function getStaticPaths() {
  return platformFeatures.map((feature) => ({
    params: { slug: feature.slug },
    props: { feature }
  }));
}

const { feature } = Astro.props as { feature: Feature };

// Each feature is illustrated with a real, live Churchify parish website.
const exampleSlugByVisual: Record<Feature["visual"], string> = {
  performance: "st-marys-drogheda-parish",
  editor: "bohermeen-parish",
  managed: "donore-rossnaree-parish",
  livestream: "duleek-bellewstown-parish",
  donations: "holy-family-drogheda-parish",
  liturgical: "drumconrath-parish",
  notices: "bohermeen-parish",
  mass: "ballivor-kildalkey-parish",
  social: "oldcastle-moylagh-parish",
  newsletter: "oldcastle-moylagh-parish"
};

const example =
  showcaseParishes.find((p) => p.slug === exampleSlugByVisual[feature.visual]) ?? showcaseParishes[0];
const shot = `/parishes/screenshots/${example.slug}.webp`;
const shotMeta = getImageMeta(shot);
const shotAlt = `Homepage of ${example.name}, a live parish website built and managed by Churchify`;

const carePoints: [string, string, string][] = [
  ["M4 6a2 2 0 012-2h12a2 2 0 012 2v10a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm2 12h12M9 21h6", "Designed into the site", "We place the feature where parishioners naturally expect to find it, on desktop and mobile."],
  ["M12 4.5v15m7.5-7.5h-15", "Prepared for your team", "The editing flow, labels and training are shaped around everyday parish-office work."],
  ["M9 12l2 2 4-4m5.6-3A11.9 11.9 0 0112 2.9 11.9 11.9 0 013.4 6 12 12 0 003 9c0 5.6 3.8 10.3 9 11.6 5.2-1.3 9-6 9-11.6 0-1-.1-2-.4-3z", "Managed after launch", "Hosting, updates, backups and support are included so the feature keeps working."]
];

const relatedFeatures = platformFeatures.filter((f) => f.slug !== feature.slug).slice(0, 3);

const pageDescription = `${feature.title} for Catholic parish websites by Churchify. ${feature.summary}`;
const featureUrl = `https://churchify.ie/features/${feature.slug}/`;
const featureSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: feature.title,
  serviceType: "Catholic parish website feature",
  description: pageDescription,
  url: featureUrl,
  provider: {
    "@type": "Organization",
    name: "Churchify",
    url: "https://churchify.ie/"
  }
};
---

<Layout
  title={`${feature.title} | Churchify Parish Website Features`}
  description={pageDescription}
  ogImage={shot}
  ogImageAlt={shotAlt}
  schema={featureSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Features", url: "/features/" },
    { name: feature.title, url: `/features/${feature.slug}/` }
  ]}
>
  <Header />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute inset-0 -z-10">
        <div class="absolute -top-40 right-[-10%] h-[40rem] w-[40rem] rounded-full bg-accent/12 blur-3xl"></div>
        <div class="absolute -bottom-44 left-[-12%] h-[36rem] w-[36rem] rounded-full bg-primary/8 blur-3xl"></div>
      </div>

      <div class="mx-auto max-w-7xl px-6 pt-12 pb-16 md:pt-16 md:pb-24 lg:px-8">
        <nav class="flex items-center gap-2 text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href="/features/" class="font-medium transition-colors hover:text-accent">Features</a>
          <span class="text-border">/</span>
          <span class="font-medium text-foreground">{feature.title}</span>
        </nav>

        <div class="mt-8 grid gap-12 lg:grid-cols-[1.05fr_1.1fr] lg:items-center lg:gap-16">
          <div>
            <Eyebrow>{feature.eyebrow}</Eyebrow>
            <h1 class="mt-6 max-w-2xl font-serif text-4xl font-bold leading-[1.05] text-foreground md:text-5xl lg:text-6xl">{feature.title}</h1>
            <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">{feature.summary}</p>

            <ul class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2.5 text-sm font-medium text-muted-foreground">
              {feature.proof.map((proof) => (
                <li class="flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
                  {proof}
                </li>
              ))}
            </ul>

            <div class="mt-10 flex flex-col gap-3 sm:flex-row">
              <a href="/contact/" class="btn btn-primary">Talk about this feature</a>
              <a href="/pricing/" class="btn btn-outline">See pricing</a>
            </div>
          </div>

          <!-- Real, live parish website -->
          <figure class="relative lg:justify-self-end">
            <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-card">
              <div class="flex items-center gap-2 border-b border-border bg-secondary/50 px-4 py-3">
                <span class="h-2.5 w-2.5 rounded-full bg-[#D56B5D]"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
                <span class="h-2.5 w-2.5 rounded-full bg-[#5E8E6E]"></span>
                <span class="ml-2 text-[11px] font-medium tracking-wide text-muted-foreground">{example.domain}</span>
              </div>
              <img
                src={shot}
                alt={shotAlt}
                class="aspect-[16/10] w-full object-cover object-top"
                width={shotMeta?.width}
                height={shotMeta?.height}
                decoding="async"
                fetchpriority="high"
              />
            </div>
            <figcaption class="absolute -bottom-4 left-4 flex items-center gap-2 rounded-full border border-border bg-card px-4 py-2 shadow-lift">
              <span class="h-2 w-2 rounded-full bg-[#5E8E6E]"></span>
              <span class="text-xs font-medium text-foreground">Live site · {example.name}</span>
              <a href={example.url} target="_blank" rel="noopener noreferrer" class="text-xs font-semibold text-accent hover:text-accent-light" aria-label={`Visit ${example.name}`}>Visit ↗</a>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Why it matters -->
    <section class="bg-secondary/40 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <Eyebrow>Why it matters</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">{feature.valueTitle}</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{feature.valueCopy}</p>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {feature.outcomes.map((outcome, index) => (
            <div class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-accent/12 font-serif text-lg font-bold text-accent">{String(index + 1).padStart(2, "0")}</span>
              <p class="mt-5 leading-relaxed text-foreground">{outcome}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- What it is + Included -->
    <section class="py-20 md:py-28">
      <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16 lg:px-8">
        <div>
          <Eyebrow>What it is</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">{feature.detailTitle}</h2>
          <p class="mt-6 text-lg leading-relaxed text-muted-foreground">{feature.whatItIs}</p>
          <div class="mt-6 space-y-4">
            {feature.details.map((paragraph) => (
              <p class="leading-relaxed text-muted-foreground">{paragraph}</p>
            ))}
          </div>
        </div>

        <div class="rounded-3xl border border-border bg-card p-8 shadow-card md:p-10">
          <Eyebrow>Included setup</Eyebrow>
          <h3 class="mt-6 font-serif text-2xl font-bold">What Churchify sets up for you</h3>
          <ul class="mt-6 space-y-3">
            {feature.includes.map((item) => (
              <li class="flex items-center gap-3.5">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-accent/12 text-accent">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <span class="font-medium text-foreground">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Churchify approach -->
    <section class="bg-secondary/40 py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="max-w-3xl">
          <Eyebrow>The Churchify way</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">Simple for parishioners, cared for behind the scenes.</h2>
        </div>

        <div class="mt-12 grid gap-6 md:grid-cols-3">
          {carePoints.map(([icon, title, copy]) => (
            <div class="rounded-2xl border border-border bg-card p-7 shadow-soft">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/12 text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={icon} /></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl font-bold">{title}</h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">{copy}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Continue exploring -->
    <section class="py-20 md:py-28">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mb-12 flex flex-col justify-between gap-5 md:flex-row md:items-end">
          <div>
            <Eyebrow>More of the platform</Eyebrow>
            <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">Explore the rest of Churchify.</h2>
          </div>
          <a href="/features/" class="btn btn-outline btn-sm shrink-0 self-start md:self-auto">View all features</a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedFeatures.map((related) => (
            <a href={`/features/${related.slug}/`} class="card-lift group rounded-2xl border border-border bg-card p-7 shadow-soft">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d={related.icon} /></svg>
              </div>
              <h3 class="mt-5 font-serif text-xl font-bold leading-snug">{related.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-muted-foreground">{related.description}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-foreground transition-colors group-hover:text-accent">
                View feature
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-20 md:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="relative overflow-hidden rounded-3xl bg-primary px-6 py-14 shadow-lift md:px-14 md:py-16">
          <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-accent/20 blur-3xl"></div>
          <div class="relative flex flex-col justify-between gap-8 md:flex-row md:items-center">
            <div>
              <Eyebrow tone="dark">Next step</Eyebrow>
              <h2 class="mt-5 max-w-2xl font-serif text-3xl font-bold text-white md:text-4xl">Bring {feature.title} into your parish website.</h2>
              <p class="mt-4 max-w-2xl leading-relaxed text-primary-foreground/70">
                Churchify designs, builds and manages this as part of one complete parish website package.
              </p>
            </div>
            <a href="/contact/" class="btn btn-accent btn-lg shrink-0">Talk to Churchify</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
