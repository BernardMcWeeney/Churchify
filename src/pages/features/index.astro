---
// src/pages/features/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { platformFeatures } from '../../data/features';

type Feature = (typeof platformFeatures)[number];
type FeatureSlug = Feature["slug"];

const featureBySlug = Object.fromEntries(
  platformFeatures.map((feature) => [feature.slug, feature])
) as Record<FeatureSlug, Feature>;

const featureGroups = [
  {
    eyebrow: "Parish Essentials",
    title: "The information people look for every week.",
    description:
      "Mass times, notices, bulletins and daily Catholic content are kept close to the surface, especially on mobile.",
    features: [
      featureBySlug["mass-times"],
      featureBySlug["notices-and-bulletin"],
      featureBySlug["daily-liturgical-content"]
    ]
  },
  {
    eyebrow: "Communication",
    title: "Publish once, then help the update travel.",
    description:
      "Parish updates can be written for the website first, then supported through email, social channels and livestream access.",
    features: [
      featureBySlug["livestream-integration"],
      featureBySlug["social-media-integration"],
      featureBySlug["email-newsletter"]
    ]
  },
  {
    eyebrow: "Managed Platform",
    title: "A polished website without parish-office stress.",
    description:
      "Churchify handles the design, editing setup, donations flow, hosting, updates, backups and day-to-day technical care.",
    features: [
      featureBySlug["fast-beautiful-design"],
      featureBySlug["easy-to-edit"],
      featureBySlug["online-donations"],
      featureBySlug["fully-managed-support"]
    ]
  }
];

const steps = [
  ["01", "We talk", "Tell us about your parish, your current website and the information parishioners need most."],
  ["02", "We build", "We design the website, organise the content, configure the parish features and prepare launch."],
  ["03", "You go live", "Your team is trained, the site goes live and Churchify stays with you for hosting and support."]
];

const pageDescription =
  "See everything included with Churchify: clear parish website design, easy editing, fully managed support, Mass times, parish notices, bulletins, Stripe donations, livestream integration and daily liturgical content.";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Complete managed parish website",
  serviceType: "Catholic parish website design and management",
  description: pageDescription,
  url: "https://churchify.ie/features/",
  provider: {
    "@type": "Organization",
    name: "Churchify",
    url: "https://churchify.ie/"
  },
  areaServed: { "@type": "Country", name: "Ireland" },
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "2000",
    description: "€2,000 once-off setup, then €500 per year ongoing.",
    url: "https://churchify.ie/pricing/"
  }
};
---

<Layout
  title="Parish Website Features & Managed Support | Churchify"
  description={pageDescription}
  ogImage="/parishes/bohermeen-church.webp"
  ogImageAlt="Bohermeen parish church used in Churchify website feature pages"
  schema={serviceSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Features", url: "/features/" }
  ]}
>
  <Header />

  <PageHeader
    eyebrow="Features"
    title="The complete parish website"
    tagline="Everything your parish needs online — designed, built and managed for you. One clear product, one calm workflow."
    image="/parishes/bohermeen-church.webp"
  />

  <!-- Intro -->
  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
        <div>
          <Eyebrow>What's included</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-5xl">Built around the weekly rhythm of parish life.</h2>
        </div>
        <div class="grid gap-4 text-lg leading-relaxed text-muted-foreground lg:pt-2">
          <p>
            Churchify is a complete parish website system rather than a generic brochure site. The structure is shaped around Mass, sacraments, notices, bulletins, giving, livestream and pastoral communication.
          </p>
          <p>
            Each feature has its own page below, but the important point is how they work together: parishioners find what they need quickly, while your team has a simpler way to keep the website current.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature groups -->
  {featureGroups.map((group, index) => (
    <section class={index % 2 === 0 ? "bg-secondary/40 py-20 md:py-24" : "py-20 md:py-24"}>
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mb-12 max-w-3xl">
          <Eyebrow>{group.eyebrow}</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">{group.title}</h2>
          <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{group.description}</p>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {group.features.map((feature) => (
            <a href={`/features/${feature.slug}/`} class="card-lift group flex flex-col rounded-2xl border border-border bg-card p-7 shadow-soft">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent transition-colors group-hover:bg-accent group-hover:text-primary">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d={feature.icon} /></svg>
              </div>
              <p class="mt-5 text-[11px] font-semibold uppercase tracking-widest text-accent">{feature.eyebrow}</p>
              <h3 class="mt-1.5 font-serif text-xl font-bold">{feature.title}</h3>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted-foreground">{feature.description}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {feature.proof.map((proof) => (
                  <span class="rounded-sm bg-secondary px-2.5 py-1 text-[11px] font-semibold text-foreground">{proof}</span>
                ))}
              </div>
              <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-foreground transition-colors group-hover:text-accent">
                View feature
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- How it works -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-14 max-w-3xl">
        <Eyebrow>Getting started</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">Three steps to a managed parish website.</h2>
      </div>
      <div class="relative grid gap-6 md:grid-cols-3">
        <div class="pointer-events-none absolute left-0 right-0 top-12 hidden h-px bg-gradient-to-r from-border via-accent/40 to-border md:block"></div>
        {steps.map(([num, title, copy]) => (
          <div class="relative rounded-2xl border border-border bg-card p-8 shadow-soft">
            <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-primary font-serif text-xl font-bold text-white shadow-soft">{num}</span>
            <h3 class="mt-6 font-serif text-2xl font-bold">{title}</h3>
            <p class="mt-3 leading-relaxed text-muted-foreground">{copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20 md:pb-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-primary px-6 py-16 text-center shadow-lift md:px-16 md:py-20">
        <div class="relative mx-auto max-w-2xl">
          <h2 class="font-serif text-3xl font-bold text-white md:text-5xl">Ready to get your parish online?</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-primary-foreground/75">
            Design, build, hosting, security, updates and support are included in one managed Churchify package.
          </p>
          <a href="/contact/" class="btn btn-accent btn-lg mt-9">Get your parish online</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
