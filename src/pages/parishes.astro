---
// src/pages/parishes.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { getImageMeta } from '../data/imageMeta';
import { parishTestimonials, showcaseParishes } from '../data/parishes';

const testimonials = parishTestimonials.map((item) => ({
  ...item,
  rating: "rating" in item.testimonial ? item.testimonial.rating : 5,
  source: "source" in item.testimonial ? item.testimonial.source : "Verified Client"
}));

const pageDescription =
  "Explore live Churchify parish website examples across Ireland with Mass times, notices, bulletins, donations, livestreams and daily parish content.";

const showcaseSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Churchify parish website showcase",
  description: pageDescription,
  url: "https://churchify.ie/parishes/",
  itemListElement: showcaseParishes.map((parish, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `https://churchify.ie/parishes/${parish.slug}/`,
    name: parish.name
  }))
};
---

<Layout
  title="Parish Website Showcase | Churchify"
  description={pageDescription}
  ogImage="/parishes/donore-church.webp"
  ogImageAlt="Donore parish church used in the Churchify showcase"
  schema={showcaseSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Parish Website Showcase", url: "/parishes/" }
  ]}
>
  <Header />

  <PageHeader
    eyebrow="Showcase"
    title="Parish website showcase"
    tagline="Live parish websites with real local imagery, daily content, Mass times, donations, livestream and parish notices — built around the needs of each community."
    image="/parishes/donore-church.webp"
  />

  <!-- Showcase grid -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-14 max-w-3xl">
        <Eyebrow>Live examples</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl font-bold md:text-5xl">Eight parishes, one dependable platform.</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
          Each site is shaped around the same parish essentials — clear navigation, parish identity, Mass information, bulletins, notices, donation pathways and spiritual content.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {showcaseParishes.map((parish) => (
          <article class="card-lift group flex flex-col overflow-hidden rounded-2xl border border-border bg-card shadow-soft">
            <a href={`/parishes/${parish.slug}/`} class="block overflow-hidden">
              <div class="flex items-center gap-1.5 border-b border-border bg-secondary/50 px-3.5 py-2.5">
                <span class="h-2 w-2 rounded-full bg-[#D56B5D]"></span>
                <span class="h-2 w-2 rounded-full bg-accent"></span>
                <span class="h-2 w-2 rounded-full bg-[#5E8E6E]"></span>
                <span class="ml-1.5 truncate text-[11px] font-medium text-muted-foreground">{parish.domain}</span>
              </div>
              <img
                src={`/parishes/screenshots/${parish.slug}.webp`}
                alt={`${parish.name} website homepage`}
                class="aspect-[16/11] w-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.03]"
                width={getImageMeta(`/parishes/screenshots/${parish.slug}.webp`)?.width}
                height={getImageMeta(`/parishes/screenshots/${parish.slug}.webp`)?.height}
                loading="lazy"
                decoding="async"
              />
            </a>

            <div class="flex flex-1 flex-col p-6">
              <span class="w-fit rounded-full bg-accent/10 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-accent">{parish.location}</span>
              <h3 class="mt-3 font-serif text-xl font-bold leading-tight">{parish.name}</h3>
              <p class="mt-2.5 flex-1 text-sm leading-relaxed text-muted-foreground">{parish.summary}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {parish.highlights.map((highlight) => (
                  <span class="rounded-full bg-secondary px-2.5 py-1 text-[11px] font-semibold text-foreground">{highlight}</span>
                ))}
              </div>
              <div class="mt-6 flex items-center justify-between border-t border-border pt-5">
                <a href={`/parishes/${parish.slug}/`} class="inline-flex items-center gap-1.5 text-sm font-semibold text-foreground transition-colors group-hover:text-accent">
                  Read case study
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
                </a>
                <a href={parish.url} target="_blank" rel="noopener noreferrer" class="text-xs font-medium text-muted-foreground transition-colors hover:text-accent">Visit ↗</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="relative overflow-hidden bg-primary py-20 md:py-28">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -left-32 top-0 h-[32rem] w-[32rem] rounded-full bg-accent/10 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-12 max-w-3xl">
        <Eyebrow tone="dark">Parish feedback</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl font-bold text-white md:text-4xl">A calmer website for busy parish teams.</h2>
        <p class="mt-4 text-lg leading-relaxed text-primary-foreground/70">
          Support, speed and ease of use matter as much as the design. These are the notes parish teams have shared after launch.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {testimonials.map((item) => (
          <a href={item.url} class="group rounded-3xl border border-white/10 bg-white/[0.07] p-7 backdrop-blur-sm transition-colors hover:bg-white/[0.11] md:p-9">
            <div class="flex items-center gap-3">
              {item.rating && (
                <div class="flex gap-0.5 text-accent" aria-label={`${item.rating} star review`}>
                  {Array.from({ length: item.rating }).map(() => (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81H7.03a1 1 0 00.95-.69l1.07-3.292z" /></svg>
                  ))}
                </div>
              )}
              <span class="rounded-full border border-white/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-primary-foreground/70">{item.source}</span>
            </div>

            <blockquote class="mt-5 font-serif text-xl font-bold leading-snug text-white md:text-2xl">
              <span class="text-accent">“</span>{item.testimonial.quote}<span class="text-accent">”</span>
            </blockquote>

            <div class="mt-7 flex items-center justify-between gap-5 border-t border-white/10 pt-5">
              <div>
                <p class="font-serif font-bold text-white">{item.testimonial.author}</p>
                <p class="text-sm text-primary-foreground/55">{item.testimonial.role}</p>
                <p class="mt-1 text-xs font-semibold text-accent">{item.parish}</p>
              </div>
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-white/10 text-white transition-transform group-hover:translate-x-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-primary-light to-primary px-6 py-16 text-center shadow-lift md:px-16 md:py-20">
        <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent/20 blur-3xl"></div>
        <div class="relative mx-auto max-w-2xl">
          <h2 class="font-serif text-3xl font-bold text-white md:text-5xl">Your parish could be next.</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-primary-foreground/75">Give parishioners a site that is beautiful, easy to use and properly managed.</p>
          <a href="/contact/" class="btn btn-accent btn-lg mt-9">Get your parish online</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
