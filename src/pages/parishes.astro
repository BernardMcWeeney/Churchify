---
// src/pages/parishes.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
import { getImageMeta } from '../data/imageMeta';
import { parishTestimonials, showcaseParishes } from '../data/parishes';

const testimonials = parishTestimonials.map((item) => ({
  ...item,
  rating: "rating" in item.testimonial ? item.testimonial.rating : 5,
  source: "source" in item.testimonial ? item.testimonial.source : "Verified Client",
  highlights: "highlights" in item.testimonial ? item.testimonial.highlights : []
}));

const pageDescription =
  "Explore live Churchify parish website examples across Ireland with Mass times, notices, bulletins, donations, livestreams and daily parish content.";

const showcaseSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Churchify parish website showcase",
  description: pageDescription,
  url: "https://churchify.ie/parishes/",
  itemListElement: showcaseParishes.map((parish, index) => ({
    "@type": "ListItem",
    position: index + 1,
    url: `https://churchify.ie/parishes/${parish.slug}/`,
    name: parish.name
  }))
};
---

<Layout
  title="Parish Website Showcase | Churchify"
  description={pageDescription}
  ogImage="/parishes/donore-church.webp"
  ogImageAlt="Donore parish church used in the Churchify showcase"
  schema={showcaseSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Parish Website Showcase", url: "/parishes/" }
  ]}
>
  <Header />

  <PageHeader
    title="Parish Website Showcase"
    tagline="Live parish websites with real local imagery, daily content, Mass times, donations, livestream and parish notices built around the needs of each community."
    image="/parishes/donore-church.webp"
  />

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-14 max-w-3xl">
        <p class="text-xs uppercase tracking-widest text-accent mb-3 font-semibold">Live Examples</p>
        <h2 class="font-serif text-3xl md:text-5xl font-bold mb-5">Parishes using Churchify-style digital tools.</h2>
        <p class="text-lg leading-relaxed text-muted-foreground">
          Each site is shaped around the same parish essentials: clear navigation, parish identity, Mass information, bulletins, notices, donation pathways and spiritual content.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
        {showcaseParishes.map((parish) => (
          <article class="group overflow-hidden rounded-lg border border-border bg-card shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/5">
            <a href={`/parishes/${parish.slug}/`} class="block">
              <div class="relative overflow-hidden">
                <img
                  src={parish.image}
                  alt={parish.alt}
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  width={getImageMeta(parish.image)?.width}
                  height={getImageMeta(parish.image)?.height}
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-primary/85 via-primary/10 to-transparent"></div>
                <span class="absolute bottom-3 left-3 rounded-md bg-accent px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-primary">{parish.location}</span>
              </div>
            </a>

            <div class="p-5">
              <h3 class="font-serif text-xl font-bold leading-tight">{parish.name}</h3>
              <p class="mt-1 text-sm font-medium text-accent">{parish.domain}</p>
              <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{parish.summary}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {parish.highlights.map((highlight) => (
                  <span class="rounded-md bg-muted px-2.5 py-1 text-[11px] font-semibold text-foreground">{highlight}</span>
                ))}
              </div>
              <a href={`/parishes/${parish.slug}/`} class="mt-5 inline-flex items-center text-sm font-semibold text-foreground transition-colors hover:text-accent">
                Read Case Study
                <svg xmlns="http://www.w3.org/2000/svg" class="ml-1.5 h-4 w-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-primary md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="mb-12 max-w-3xl">
        <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">Parish Feedback</p>
        <h2 class="font-serif text-3xl font-bold text-primary-foreground md:text-4xl">A calmer website for busy parish teams.</h2>
        <p class="mt-4 text-lg leading-relaxed text-primary-foreground/72">
          Support, speed and ease of use matter as much as the design. These are the notes parish teams have shared after launch.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        {testimonials.map((item) => (
          <a href={item.url} class="group rounded-lg border border-white/10 bg-white/[0.06] p-7 transition-colors hover:bg-white/10 md:p-8">
            <div class="flex flex-wrap items-center gap-3">
              {item.rating && (
                <div class="flex gap-1 text-accent" aria-label={`${item.rating} star review`}>
                  {Array.from({ length: item.rating }).map(() => (
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81H7.03a1 1 0 00.95-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
              )}
              <span class="rounded-md border border-white/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wider text-primary-foreground/72">
                {item.source}
              </span>
            </div>

            <p class="mt-6 text-accent text-5xl leading-none">"</p>
            <blockquote class="mt-4 font-serif text-xl font-bold leading-snug text-primary-foreground md:text-2xl">
              {item.testimonial.quote}
            </blockquote>

            {item.highlights.length > 0 && (
              <ul class="mt-5 grid gap-2 border-t border-white/10 pt-5">
                {item.highlights.map((highlight) => (
                  <li class="flex gap-2 text-sm leading-relaxed text-primary-foreground/72">
                    <span class="mt-1 flex h-4 w-4 shrink-0 items-center justify-center rounded bg-accent text-primary">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-2.5 w-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                    </span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-7 flex items-center justify-between gap-5 border-t border-white/10 pt-5">
              <div>
                <p class="font-serif font-bold text-primary-foreground">{item.testimonial.author}</p>
                <p class="text-sm text-primary-foreground/58">{item.testimonial.role}</p>
                <p class="mt-1 text-xs font-semibold text-accent">{item.parish}</p>
              </div>
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-white/10 text-primary-foreground transition-transform group-hover:translate-x-0.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img src="/parishes/duleek-aerial.webp" alt="" class="w-full h-full object-cover" width="1024" height="682" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-primary/90"></div>
    </div>

    <div class="mx-auto max-w-7xl px-6 lg:px-8 text-center relative z-10">
      <h2 class="font-serif text-3xl md:text-5xl font-bold mb-6 text-white">Your parish could be next.</h2>
      <p class="text-lg mb-10 max-w-2xl mx-auto text-white/80 leading-relaxed">Give parishioners a site that is beautiful, easy to use and properly managed.</p>
      <a href="/contact/" class="inline-flex rounded-lg bg-accent px-8 py-4 font-semibold text-foreground shadow-lg transition-colors hover:bg-accent/90">
        Get Your Parish Online
      </a>
    </div>
  </section>

  <Footer />
</Layout>
