---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import Values from '../components/about/Values.astro';
import Mission from '../components/about/Mission.astro';
import Story from '../components/about/Story.astro';
import Footer from '../components/Footer.astro';

const pageDescription =
  "Learn about Churchify, a managed parish website service for Catholic parishes in Ireland, with modern design, easy editing and support.";

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  name: "About Churchify",
  description: pageDescription,
  url: "https://churchify.ie/about/"
};
---

<Layout
  title="About Churchify | Managed Parish Website Specialists"
  description={pageDescription}
  ogImage="/parishes/duleek-aerial.webp"
  ogImageAlt="Duleek parish church aerial image used by Churchify"
  schema={aboutSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "About Churchify", url: "/about/" }
  ]}
>
  <Header />

  <PageHeader
    eyebrow="About"
    title="About Churchify"
    tagline="One product. One audience. One promise. We build the modern parish website."
    image="/parishes/duleek-aerial.webp"
  />

  <Story />

  <Mission />

  <Values />

  <!-- CTA Section -->
  <section class="bg-secondary/40 py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-primary px-6 py-16 text-center shadow-lift md:px-16 md:py-20">
        <div class="absolute inset-0 z-0">
          <img src="/parishes/holy-family-church.webp" alt="" class="h-full w-full object-cover opacity-20" width="960" height="960" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-br from-primary via-primary/95 to-primary-light/90"></div>
          <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent/20 blur-3xl"></div>
        </div>
        <div class="relative z-10 mx-auto max-w-2xl">
          <h2 class="font-serif text-3xl font-bold text-white md:text-5xl">Ready to give your parish a modern home online?</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-primary-foreground/75">€2,000 setup. €500 per year. Everything included.</p>
          <a href="/contact/" class="btn btn-accent btn-lg mt-9">Contact our team</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
