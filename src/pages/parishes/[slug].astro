---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import { getImageMeta } from '../../data/imageMeta';
import { showcaseParishes } from '../../data/parishes';

export function getStaticPaths() {
  return showcaseParishes.map((parish) => ({
    params: { slug: parish.slug },
    props: { parish }
  }));
}

const { parish } = Astro.props;
const shot = `/parishes/screenshots/${parish.slug}.webp`;
const shotMeta = getImageMeta(shot);

const parishTestimonial = "testimonial" in parish ? parish.testimonial : null;
const quoteText = parishTestimonial?.quote ?? parish.caseStudy.quote;
const quoteAuthor = parishTestimonial?.author ?? parish.caseStudy.quoteBy;
const quoteRole = parishTestimonial?.role ?? "";
const quoteRating = parishTestimonial
  ? ("rating" in parishTestimonial ? parishTestimonial.rating : 5)
  : undefined;
const quoteSource = parishTestimonial
  ? ("source" in parishTestimonial ? parishTestimonial.source : "Verified Client")
  : "Case study note";
const quoteInitials = quoteAuthor
  .split(/[,\s]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((part) => part.charAt(0).toUpperCase())
  .join("");

const pageDescription = `${parish.name} website case study by Churchify, showing a managed parish site with ${parish.highlights.join(", ").toLowerCase()}.`;
const pageUrl = `https://churchify.ie/parishes/${parish.slug}/`;
const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: `${parish.name} website case study`,
  description: pageDescription,
  url: pageUrl,
  image: `https://churchify.ie${parish.image}`,
  about: {
    "@type": "WebSite",
    name: parish.name,
    url: parish.url
  }
};
---

<Layout
  title={`${parish.name} Website Case Study | Churchify`}
  description={pageDescription}
  ogImage={shot}
  ogImageAlt={`${parish.name} website homepage`}
  schema={caseStudySchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Parish Website Showcase", url: "/parishes/" },
    { name: parish.name, url: `/parishes/${parish.slug}/` }
  ]}
>
  <Header />

  <PageHeader
    eyebrow="Case Study"
    title={parish.name}
    tagline={parish.summary}
    image={parish.image}
    imageAlt={parish.alt}
  />

  <!-- Overview: the live site + facts -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.25fr_0.75fr] lg:gap-14">
        <figure>
          <div class="overflow-hidden rounded-2xl border border-border bg-card shadow-card">
            <div class="flex items-center gap-2 border-b border-border bg-secondary/50 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-[#D56B5D]"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-accent"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-[#5E8E6E]"></span>
              <span class="ml-2 text-[11px] font-medium text-muted-foreground">{parish.domain}</span>
            </div>
            <img
              src={shot}
              alt={`${parish.name} website homepage`}
              class="aspect-[16/10] w-full object-cover object-top"
              width={shotMeta?.width}
              height={shotMeta?.height}
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
          <figcaption class="mt-3 text-center text-sm text-muted-foreground">The live {parish.name} website, built and managed by Churchify.</figcaption>
        </figure>

        <aside class="lg:pt-2">
          <Eyebrow>{parish.location}</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold">{parish.name}</h2>
          <p class="mt-2 text-sm font-medium text-accent">{parish.domain}</p>

          <div class="mt-6 flex flex-wrap gap-2">
            {parish.highlights.map((highlight) => (
              <span class="rounded-full bg-secondary px-3 py-1.5 text-xs font-semibold text-foreground">{highlight}</span>
            ))}
          </div>

          <div class="mt-8 flex flex-col gap-3">
            <a href={parish.url} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              Visit live website
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H8M17 7v9" /></svg>
            </a>
            <a href="/parishes/" class="btn btn-outline">Back to showcase</a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Pull quote -->
  <section class="bg-secondary/40 py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-6 text-center lg:px-8">
      {quoteRating && (
        <div class="flex justify-center gap-1 text-accent" aria-label={`${quoteRating} star review`}>
          {Array.from({ length: quoteRating }).map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.539 1.118l-2.8-2.034a1 1 0 00-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81H7.03a1 1 0 00.95-.69l1.07-3.292z" /></svg>
          ))}
        </div>
      )}
      <blockquote class="mt-6 font-serif text-2xl font-bold leading-snug text-foreground md:text-3xl">
        <span class="text-accent">“</span>{quoteText}<span class="text-accent">”</span>
      </blockquote>
      <div class="mt-8 flex items-center justify-center gap-4">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-primary-light to-primary font-serif text-sm font-bold text-white">{quoteInitials}</div>
        <div class="text-left">
          <p class="font-serif font-bold text-foreground">{quoteAuthor}</p>
          {quoteRole && <p class="text-sm text-muted-foreground">{quoteRole}</p>}
        </div>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="max-w-3xl">
        <Eyebrow>Background</Eyebrow>
        <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">What this parish needed online.</h2>
        <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{parish.caseStudy.background}</p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2">
        <div class="rounded-2xl border border-border bg-card p-8 shadow-soft">
          <Eyebrow>Approach</Eyebrow>
          <ul class="mt-6 space-y-4">
            {parish.caseStudy.approach.map((item) => (
              <li class="flex gap-3.5 leading-relaxed text-muted-foreground">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-accent/12 text-accent">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-border bg-gradient-to-br from-primary-light to-primary p-8 text-primary-foreground shadow-card">
          <Eyebrow tone="dark">Outcome</Eyebrow>
          <ul class="mt-6 space-y-4">
            {parish.caseStudy.outcome.map((item) => (
              <li class="flex gap-3.5 leading-relaxed text-primary-foreground/80">
                <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-accent text-primary">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                </span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-20 md:pb-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl border border-border bg-card px-6 py-14 shadow-card md:px-14 md:py-16">
        <div class="pointer-events-none absolute -right-16 -top-20 h-64 w-64 rounded-full bg-accent/10 blur-3xl"></div>
        <div class="relative max-w-3xl">
          <Eyebrow>Churchify pattern</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">The same foundations can be adapted for your parish.</h2>
          <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
            Every parish has its own people, churches, imagery and priorities. Churchify keeps the core system consistent while shaping the design, content and navigation around your actual parish community.
          </p>
          <a href="/contact/" class="btn btn-primary mt-8">Talk about your parish</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
