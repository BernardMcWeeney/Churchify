---
// src/pages/pricing.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import ParishInABox from '../components/index/ParishInABox.astro';
import Footer from '../components/Footer.astro';

const pageDescription =
  "Churchify pricing is simple and transparent for Catholic parishes in Ireland: €2,000 once-off setup, then €500 per year for hosting, support, updates and management.";

const pricingBreakdown = [
  {
    label: "Setup",
    price: "€2,000",
    detail:
      "A once-off project fee for design, build, content setup, launch preparation and parish training."
  },
  {
    label: "Ongoing care",
    price: "€500 / year",
    detail:
      "Annual hosting, support, updates, backups, security monitoring and technical management."
  },
  {
    label: "First year total",
    price: "€2,500",
    detail:
      "Your first year includes the full website build plus the first year of managed care."
  }
];

const clarityPoints = [
  "One parish website package",
  "No feature tiers to compare",
  "No hidden hosting fees",
  "No surprise maintenance costs"
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Churchify parish website pricing",
  serviceType: "Catholic parish website design, development and management",
  description: pageDescription,
  url: "https://churchify.ie/pricing/",
  provider: {
    "@type": "Organization",
    name: "Churchify",
    url: "https://churchify.ie/"
  },
  areaServed: {
    "@type": "Country",
    name: "Ireland"
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "2000",
    description:
      "€2,000 once-off setup, then €500 per year for hosting, support, updates and management.",
    url: "https://churchify.ie/pricing/"
  }
};
---

<Layout
  title="Pricing | Simple Parish Website Pricing | Churchify"
  description={pageDescription}
  ogImage="/parishes/st-marys-altar.jpg"
  ogImageAlt="St. Mary's Parish Drogheda altar used for Churchify parish website pricing"
  schema={pricingSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Pricing", url: "/pricing/" }
  ]}
>
  <Header />

  <PageHeader
    title="Pricing"
    tagline="One simple, transparent Churchify package for parishes: €2,000 setup, then €500 per year."
    image="/parishes/st-marys-altar.jpg"
  />

  <ParishInABox showIntro={false} />

  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">Clear Breakdown</p>
          <h2 class="font-serif text-3xl font-bold md:text-5xl">A parish website price you can explain in one sentence.</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            Churchify keeps pricing straightforward so the parish can budget confidently before the work begins.
          </p>
        </div>

        <div class="grid gap-4">
          {pricingBreakdown.map((item) => (
            <article class="rounded-lg border border-border bg-card p-6 shadow-sm">
              <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-widest text-accent">{item.label}</p>
                  <p class="mt-3 text-sm leading-relaxed text-muted-foreground">{item.detail}</p>
                </div>
                <p class="shrink-0 font-serif text-3xl font-bold text-foreground">{item.price}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-secondary/50 py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-accent">No Hidden Extras</p>
          <h2 class="font-serif text-3xl font-bold md:text-4xl">One package, not a maze of add-ons.</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            The price includes the website build and the ongoing technical care a parish needs after launch.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {clarityPoints.map((point) => (
            <div class="flex items-center gap-3 rounded-lg border border-border bg-card p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-sm font-semibold text-foreground">{point}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden py-20 md:py-24">
    <div class="absolute inset-0 z-0">
      <img src="/parishes/holy-family-church.webp" alt="" class="h-full w-full object-cover" loading="lazy" decoding="async" />
      <div class="absolute inset-0 bg-primary/90"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-7xl px-6 text-center lg:px-8">
      <h2 class="font-serif text-3xl font-bold text-white md:text-5xl">Ready to talk through your parish website?</h2>
      <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-white/80">
        We can confirm the fit, explain the process and answer any practical questions before you commit.
      </p>
      <a href="/contact/" class="mt-9 inline-flex rounded-lg bg-accent px-8 py-4 font-semibold text-foreground shadow-lg transition-colors hover:bg-accent/90">
        Contact Churchify
      </a>
    </div>
  </section>

  <Footer />
</Layout>
