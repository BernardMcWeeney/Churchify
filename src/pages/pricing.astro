---
// src/pages/pricing.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PageHeader from '../components/PageHeader.astro';
import ParishInABox from '../components/index/ParishInABox.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Footer from '../components/Footer.astro';

const pageDescription =
  "Churchify pricing is simple and transparent for Catholic parishes in Ireland: €2,000 once-off setup, then €500 per year for hosting, support, updates and management.";

const pricingBreakdown = [
  {
    label: "Setup",
    price: "€2,000",
    detail:
      "A once-off project fee for design, build, content setup, launch preparation and parish training."
  },
  {
    label: "Ongoing care",
    price: "€500 / year",
    detail:
      "Annual hosting, support, updates, backups, security monitoring and technical management."
  },
  {
    label: "First year total",
    price: "€2,500",
    detail:
      "Your first year includes the full website build plus the first year of managed care."
  }
];

const clarityPoints = [
  "One parish website package",
  "No feature tiers to compare",
  "No hidden hosting fees",
  "No surprise maintenance costs"
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Churchify parish website pricing",
  serviceType: "Catholic parish website design, development and management",
  description: pageDescription,
  url: "https://churchify.ie/pricing/",
  provider: {
    "@type": "Organization",
    name: "Churchify",
    url: "https://churchify.ie/"
  },
  areaServed: {
    "@type": "Country",
    name: "Ireland"
  },
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "2000",
    description:
      "€2,000 once-off setup, then €500 per year for hosting, support, updates and management.",
    url: "https://churchify.ie/pricing/"
  }
};
---

<Layout
  title="Pricing | Simple Parish Website Pricing | Churchify"
  description={pageDescription}
  ogImage="/parishes/st-marys-altar.jpg"
  ogImageAlt="St. Mary's Parish Drogheda altar used for Churchify parish website pricing"
  schema={pricingSchema}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Pricing", url: "/pricing/" }
  ]}
>
  <Header />

  <PageHeader
    eyebrow="Pricing"
    title="Simple, transparent pricing"
    tagline="One clear Churchify package for parishes: €2,000 setup, then €500 per year — fully managed."
    image="/parishes/st-marys-altar.jpg"
  />

  <ParishInABox showIntro={false} />

  <section class="py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
        <div>
          <Eyebrow>Clear breakdown</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-5xl">A price you can explain in one sentence.</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            Churchify keeps pricing straightforward so the parish can budget confidently before the work begins.
          </p>
        </div>

        <div class="grid gap-4">
          {pricingBreakdown.map((item, index) => (
            <article class={`card-lift rounded-2xl border border-border p-7 shadow-soft ${index === 2 ? "bg-primary text-primary-foreground" : "bg-card"}`}>
              <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class={`text-[11px] font-semibold uppercase tracking-widest ${index === 2 ? "text-accent" : "text-accent"}`}>{item.label}</p>
                  <p class={`mt-2.5 text-sm leading-relaxed ${index === 2 ? "text-primary-foreground/75" : "text-muted-foreground"}`}>{item.detail}</p>
                </div>
                <p class={`shrink-0 font-serif text-4xl font-bold ${index === 2 ? "text-white" : "text-foreground"}`}>{item.price}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-secondary/40 py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <Eyebrow>No hidden extras</Eyebrow>
          <h2 class="mt-6 font-serif text-3xl font-bold md:text-4xl">One package, not a maze of add-ons.</h2>
          <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
            The price includes the website build and the ongoing technical care a parish needs after launch.
          </p>
        </div>

        <div class="grid gap-3 sm:grid-cols-2">
          {clarityPoints.map((point) => (
            <div class="flex items-center gap-3 rounded-2xl border border-border bg-card p-5 shadow-soft">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent/12 text-accent">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span class="text-sm font-semibold text-foreground">{point}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-primary px-6 py-16 text-center shadow-lift md:px-16 md:py-20">
        <div class="absolute inset-0 z-0">
          <img src="/parishes/holy-family-church.webp" alt="" class="h-full w-full object-cover opacity-20" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-primary/92"></div>
        </div>
        <div class="relative z-10 mx-auto max-w-2xl">
          <h2 class="font-serif text-3xl font-bold text-white md:text-5xl">Ready to talk through your parish website?</h2>
          <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-primary-foreground/75">
            We can confirm the fit, explain the process and answer any practical questions before you commit.
          </p>
          <a href="/contact/" class="btn btn-accent btn-lg mt-9">Contact Churchify</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
